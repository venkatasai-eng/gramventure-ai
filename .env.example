# GramVenture AI — Environment Configuration Example
# Copy this file to .env.local to customize your development environment.

# Optional: Google Gemini API Key for dynamic natural language explanations.
# If omitted or left empty, GramVenture AI operates seamlessly using its
# built-in 100% deterministic rule-based advisory engine.
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Application Mode: 'demo' | 'production'
VITE_APP_MODE=demo
